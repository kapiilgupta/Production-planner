<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Production Planning & Scheduling System</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="logo">
                <i class="fas fa-industry"></i>
                <h1>Production Planner</h1>
            </div>
            <nav class="nav">
                <a href="#dashboard" class="nav-link active" data-page="dashboard">
                    <i class="fas fa-chart-line"></i> Dashboard
                </a>
                <a href="#products" class="nav-link" data-page="products">
                    <i class="fas fa-box"></i> Products
                </a>
                <a href="#inventory" class="nav-link" data-page="inventory">
                    <i class="fas fa-warehouse"></i> Inventory
                </a>
                <a href="#forecast" class="nav-link" data-page="forecast">
                    <i class="fas fa-chart-bar"></i> Forecast
                </a>
                <a href="#planning" class="nav-link" data-page="planning">
                    <i class="fas fa-clipboard-list"></i> Planning
                </a>
                <a href="#schedule" class="nav-link" data-page="schedule">
                    <i class="fas fa-calendar-alt"></i> Schedule
                </a>
                <a href="#machines" class="nav-link" data-page="machines">
                    <i class="fas fa-cog"></i> Machines
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container">
            
            <!-- Dashboard Page -->
            <div id="dashboard" class="page active">
                <h2 class="page-title">Dashboard Overview</h2>
                
                <div class="stats-grid">
                    <div class="stat-card">
                        <i class="fas fa-box stat-icon"></i>
                        <div class="stat-info">
                            <h3 id="total-products">0</h3>
                            <p>Total Products</p>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <i class="fas fa-warehouse stat-icon"></i>
                        <div class="stat-info">
                            <h3 id="total-inventory">0</h3>
                            <p>Inventory Items</p>
                        </div>
                    </div>
                    
                    <div class="stat-card alert">
                        <i class="fas fa-exclamation-triangle stat-icon"></i>
                        <div class="stat-info">
                            <h3 id="low-stock-count">0</h3>
                            <p>Low Stock Alerts</p>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <i class="fas fa-clipboard-list stat-icon"></i>
                        <div class="stat-info">
                            <h3 id="pending-orders">0</h3>
                            <p>Pending Orders</p>
                        </div>
                    </div>
                </div>

                <div class="dashboard-grid">
                    <div class="card">
                        <h3><i class="fas fa-exclamation-circle"></i> Low Stock Alerts</h3>
                        <div id="low-stock-alerts" class="alerts-list">
                            <p class="loading">Loading...</p>
                        </div>
                    </div>

                    <div class="card">
                        <h3><i class="fas fa-tasks"></i> Recent Production Orders</h3>
                        <div id="recent-orders" class="orders-list">
                            <p class="loading">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Products Page -->
            <div id="products" class="page">
                <div class="page-header">
                    <h2 class="page-title">Products Management</h2>
                    <button class="btn btn-primary" onclick="openProductModal()">
                        <i class="fas fa-plus"></i> Add Product
                    </button>
                </div>

                <div class="table-container">
                    <table class="data-table" id="products-table">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Sizes</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="products-tbody">
                            <tr>
                                <td colspan="5" class="loading">Loading products...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Inventory Page -->
            <div id="inventory" class="page">
                <div class="page-header">
                    <h2 class="page-title">Inventory Management</h2>
                    <button class="btn btn-secondary" onclick="refreshInventory()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>

                <div class="filter-bar">
                    <input type="text" id="inventory-search" placeholder="Search by SKU..." class="search-input">
                    <button class="btn btn-warning" onclick="showLowStockOnly()">
                        <i class="fas fa-filter"></i> Low Stock Only
                    </button>
                </div>

                <div class="table-container">
                    <table class="data-table" id="inventory-table">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Product</th>
                                <th>Size</th>
                                <th>Quantity on Hand</th>
                                <th>Reorder Point</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-tbody">
                            <tr>
                                <td colspan="7" class="loading">Loading inventory...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Forecast Page -->
            <div id="forecast" class="page">
                <div class="page-header">
                    <h2 class="page-title">Demand Forecasting</h2>
                    <button class="btn btn-primary" onclick="openForecastModal()">
                        <i class="fas fa-chart-line"></i> Generate Forecast
                    </button>
                </div>

                <div class="filter-bar">
                    <label>Period:</label>
                    <input type="month" id="forecast-period-filter" class="input-field">
                    <button class="btn btn-secondary" onclick="filterForecasts()">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>

                <div class="table-container">
                    <table class="data-table" id="forecast-table">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Product</th>
                                <th>Period</th>
                                <th>Forecast Qty</th>
                                <th>Algorithm</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="forecast-tbody">
                            <tr>
                                <td colspan="7" class="loading">No forecasts generated yet</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Planning Page -->
            <div id="planning" class="page">
                <div class="page-header">
                    <h2 class="page-title">Production Planning</h2>
                    <button class="btn btn-primary" onclick="openPlanningModal()">
                        <i class="fas fa-plus-circle"></i> Generate Orders
                    </button>
                </div>

                <div class="filter-bar">
                    <label>Status:</label>
                    <select id="order-status-filter" class="input-field" onchange="filterOrders()">
                        <option value="">All</option>
                        <option value="pending">Pending</option>
                        <option value="scheduled">Scheduled</option>
                        <option value="in-progress">In Progress</option>
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="table-container">
                    <table class="data-table" id="orders-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Product</th>
                                <th>Items</th>
                                <th>Due Date</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="orders-tbody">
                            <tr>
                                <td colspan="7" class="loading">No production orders yet</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Schedule Page -->
            <div id="schedule" class="page">
                <div class="page-header">
                    <h2 class="page-title">Production Schedule</h2>
                    <button class="btn btn-primary" onclick="openScheduleModal()">
                        <i class="fas fa-calendar-plus"></i> Generate Schedule
                    </button>
                </div>

                <div class="filter-bar">
                    <label>Date:</label>
                    <input type="date" id="schedule-date-filter" class="input-field">
                    <button class="btn btn-secondary" onclick="filterSchedule()">
                        <i class="fas fa-search"></i> View Schedule
                    </button>
                    <button class="btn btn-info" onclick="viewUtilization()">
                        <i class="fas fa-chart-pie"></i> Utilization Report
                    </button>
                </div>

                <div class="table-container">
                    <table class="data-table" id="schedule-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Machine</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Duration</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="schedule-tbody">
                            <tr>
                                <td colspan="6" class="loading">Select a date to view schedule</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div id="utilization-report" class="card" style="display: none; margin-top: 20px;">
                    <h3><i class="fas fa-chart-bar"></i> Machine Utilization Report</h3>
                    <div id="utilization-content"></div>
                </div>
            </div>

            <!-- Machines Page -->
            <div id="machines" class="page">
                <div class="page-header">
                    <h2 class="page-title">Machines Management</h2>
                    <button class="btn btn-primary" onclick="openMachineModal()">
                        <i class="fas fa-plus"></i> Add Machine
                    </button>
                </div>

                <div class="table-container">
                    <table class="data-table" id="machines-table">
                        <thead>
                            <tr>
                                <th>Machine Name</th>
                                <th>Type</th>
                                <th>Shift Time</th>
                                <th>Shift Minutes</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="machines-tbody">
                            <tr>
                                <td colspan="6" class="loading">Loading machines...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <!-- Modals -->
    
    <!-- Add Product Modal -->
    <div id="product-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-box"></i> Add New Product</h3>
                <span class="close" onclick="closeModal('product-modal')">&times;</span>
            </div>
            <div class="modal-body">
                <form id="product-form" onsubmit="submitProduct(event)">
                    <div class="form-group">
                        <label>Product Name</label>
                        <input type="text" name="name" required class="input-field">
                    </div>
                    
                    <div class="form-group">
                        <label>Category</label>
                        <select name="category" required class="input-field">
                            <option value="">Select Category</option>
                            <option value="Apparel">Apparel</option>
                            <option value="Footwear">Footwear</option>
                            <option value="Accessories">Accessories</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <h4>Sizes</h4>
                    <div id="sizes-container">
                        <div class="size-row">
                            <input type="text" placeholder="Size Label (e.g., S)" class="input-field size-label" required>
                            <input type="text" placeholder="SKU" class="input-field size-sku" required>
                            <input type="number" placeholder="Minutes/Unit" class="input-field size-minutes" step="0.1" required>
                            <input type="number" placeholder="Material/Unit" class="input-field size-material" step="0.1" required>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeSizeRow(this)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    
                    <button type="button" class="btn btn-secondary btn-sm" onclick="addSizeRow()">
                        <i class="fas fa-plus"></i> Add Size
                    </button>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('product-modal')">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Update Inventory Modal -->
    <div id="inventory-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-edit"></i> Update Inventory</h3>
                <span class="close" onclick="closeModal('inventory-modal')">&times;</span>
            </div>
            <div class="modal-body">
                <form id="inventory-form" onsubmit="submitInventoryUpdate(event)">
                    <input type="hidden" id="inventory-sku" name="sku">
                    
                    <div class="form-group">
                        <label>SKU</label>
                        <input type="text" id="inventory-sku-display" class="input-field" disabled>
                    </div>

                    <div class="form-group">
                        <label>Quantity on Hand</label>
                        <input type="number" id="inventory-qty" name="quantityOnHand" required class="input-field" min="0">
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('inventory-modal')">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Generate Forecast Modal -->
    <div id="forecast-modal" class="modal">
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h3><i class="fas fa-chart-line"></i> Generate Demand Forecast</h3>
                <span class="close" onclick="closeModal('forecast-modal')">&times;</span>
            </div>
            <div class="modal-body">
                <form id="forecast-form" onsubmit="submitForecast(event)">
                    <div class="form-group">
                        <label>Forecast Period</label>
                        <input type="month" id="forecast-period" name="forecastPeriod" required class="input-field">
                    </div>

                    <h4>Historical Sales Data (Last 3 Months)</h4>
                    <p class="help-text">Enter sales data for each SKU to generate forecast</p>
                    
                    <div id="forecast-data-container" class="forecast-container">
                        <p class="loading">Select products first or loading...</p>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('forecast-modal')">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-calculator"></i> Generate Forecast
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Generate Planning Modal -->
    <div id="planning-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-clipboard-list"></i> Generate Production Orders</h3>
                <span class="close" onclick="closeModal('planning-modal')">&times;</span>
            </div>
            <div class="modal-body">
                <form id="planning-form" onsubmit="submitPlanning(event)">
                    <div class="form-group">
                        <label>Forecast Period</label>
                        <input type="month" id="planning-period" name="forecastPeriod" required class="input-field">
                        <p class="help-text">Production orders will be generated based on forecasts for this period</p>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('planning-modal')">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-magic"></i> Generate Orders
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Generate Schedule Modal -->
    <div id="schedule-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-calendar-plus"></i> Generate Production Schedule</h3>
                <span class="close" onclick="closeModal('schedule-modal')">&times;</span>
            </div>
            <div class="modal-body">
                <form id="schedule-form" onsubmit="submitSchedule(event)">
                    <div class="form-group">
                        <label>Schedule Date</label>
                        <input type="date" id="schedule-date" name="scheduleDate" required class="input-field">
                        <p class="help-text">All pending orders will be scheduled for this date using EDD algorithm</p>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('schedule-modal')">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-calendar-check"></i> Generate Schedule
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Machine Modal -->
    <div id="machine-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-cog"></i> Add New Machine</h3>
                <span class="close" onclick="closeModal('machine-modal')">&times;</span>
            </div>
            <div class="modal-body">
                <form id="machine-form" onsubmit="submitMachine(event)">
                    <div class="form-group">
                        <label>Machine Name</label>
                        <input type="text" name="name" required class="input-field">
                    </div>

                    <div class="form-group">
                        <label>Type</label>
                        <select name="type" required class="input-field">
                            <option value="">Select Type</option>
                            <option value="Cutting">Cutting</option>
                            <option value="Sewing">Sewing</option>
                            <option value="Printing">Printing</option>
                            <option value="Packaging">Packaging</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Shift Start</label>
                            <input type="time" name="shiftStartTime" required class="input-field" value="06:00">
                        </div>

                        <div class="form-group">
                            <label>Shift End</label>
                            <input type="time" name="shiftEndTime" required class="input-field" value="18:00">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Shift Minutes</label>
                        <input type="number" name="shiftMinutes" required class="input-field" value="720">
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('machine-modal')">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Machine
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast"></div>

    <!-- Scripts -->
    <script src="js/api.js"></script>
    <script src="js/products.js"></script>
    <script src="js/inventory.js"></script>
    <script src="js/forecast.js"></script>
    <script src="js/planning.js"></script>
    <script src="js/schedule.js"></script>
    <script src="js/app.js"></script>
</body>
</html>