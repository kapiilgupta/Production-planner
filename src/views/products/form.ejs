<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Production Planner</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="main-content">
    <div class="page-header">
      <h1 class="page-title"><%= title %></h1>
      <a href="/products" class="btn btn-secondary">← Back</a>
    </div>

    <% if (errors.length > 0) { %>
      <div class="alert alert-error">
        <ul><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
      </div>
    <% } %>

    <div class="card form-card">
      <form method="POST" action="<%= product ? '/products/' + product._id : '/products' %>">
        <div class="form-group">
          <label for="name">Product Name *</label>
          <input id="name" type="text" name="name" class="input"
                 value="<%= product ? product.name : '' %>" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="sku">SKU *</label>
            <input id="sku" type="text" name="sku" class="input"
                   value="<%= product ? product.sku : '' %>" required />
          </div>
          <div class="form-group">
            <label for="category">Category *</label>
            <select id="category" name="category" class="input">
              <% ['Electronics','Machinery','Consumables','Raw Materials','Other'].forEach(c => { %>
                <option value="<%= c %>" <%= (product && product.category === c) ? 'selected' : '' %>><%= c %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="unitCost">Unit Cost ($) *</label>
            <input id="unitCost" type="number" name="unitCost" step="0.01" min="0" class="input"
                   value="<%= product ? product.unitCost : '' %>" required />
          </div>
          <div class="form-group">
            <label for="leadTimeDays">Lead Time (days) *</label>
            <input id="leadTimeDays" type="number" name="leadTimeDays" min="0" class="input"
                   value="<%= product ? product.leadTimeDays : 7 %>" required />
          </div>
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" class="input" rows="3"><%= product ? product.description : '' %></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%= product ? 'Update Product' : 'Create Product' %></button>
          <a href="/products" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
