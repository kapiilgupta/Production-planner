<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Production Planner</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="main-content">
    <div class="page-header">
      <h1 class="page-title"><%= title %></h1>
      <a href="/planning" class="btn btn-secondary">← Back</a>
    </div>

    <% if (errors.length > 0) { %>
      <div class="alert alert-error"><ul><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul></div>
    <% } %>

    <div class="card form-card">
      <form method="POST" action="/planning">
        <div class="form-group">
          <label for="product">Product *</label>
          <select id="product" name="product" class="input" required>
            <option value="">-- Select Product --</option>
            <% products.forEach(p => { %>
              <option value="<%= p._id %>"><%= p.name %> (<%= p.sku %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="quantity">Quantity *</label>
            <input id="quantity" type="number" name="quantity" min="1" class="input" required />
          </div>
          <div class="form-group">
            <label for="priority">Priority</label>
            <select id="priority" name="priority" class="input">
              <option value="low">Low</option>
              <option value="medium" selected>Medium</option>
              <option value="high">High</option>
              <option value="urgent">Urgent</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="plannedStartDate">Planned Start Date *</label>
            <input id="plannedStartDate" type="date" name="plannedStartDate" class="input" required />
          </div>
          <div class="form-group">
            <label for="plannedEndDate">Planned End Date *</label>
            <input id="plannedEndDate" type="date" name="plannedEndDate" class="input" required />
          </div>
        </div>
        <div class="form-group">
          <label for="assignedMachine">Assign Machine (optional)</label>
          <select id="assignedMachine" name="assignedMachine" class="input">
            <option value="">-- Auto-assign later --</option>
            <% machines.forEach(m => { %>
              <option value="<%= m._id %>"><%= m.name %> (<%= m.type %> | <%= m.capacityPerHour %>/hr)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" class="input" rows="3"></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Create Order</button>
          <a href="/planning" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
