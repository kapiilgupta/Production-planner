<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Production Planner</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="main-content">
    <div class="page-header">
      <h1 class="page-title"><%= title %></h1>
      <a href="/inventory" class="btn btn-secondary">← Back</a>
    </div>

    <% if (errors.length > 0) { %>
      <div class="alert alert-error"><ul><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul></div>
    <% } %>

    <div class="card form-card">
      <form method="POST" action="<%= item ? '/inventory/' + item._id : '/inventory' %>">
        <div class="form-group">
          <label for="product">Product *</label>
          <select id="product" name="product" class="input" required>
            <option value="">-- Select Product --</option>
            <% products.forEach(p => { %>
              <option value="<%= p._id %>" <%= (item && item.product == p._id.toString()) ? 'selected' : '' %>>
                <%= p.name %> (<%= p.sku %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="quantity">Quantity *</label>
            <input id="quantity" type="number" name="quantity" min="0" class="input"
                   value="<%= item ? item.quantity : 0 %>" required />
          </div>
          <div class="form-group">
            <label for="reorderPoint">Reorder Point *</label>
            <input id="reorderPoint" type="number" name="reorderPoint" min="0" class="input"
                   value="<%= item ? item.reorderPoint : 50 %>" required />
          </div>
        </div>
        <div class="form-group">
          <label for="warehouseLocation">Warehouse Location</label>
          <input id="warehouseLocation" type="text" name="warehouseLocation" class="input"
                 value="<%= item ? item.warehouseLocation : 'Main Warehouse' %>" />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%= item ? 'Update' : 'Create' %> Record</button>
          <a href="/inventory" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
